{
  "uid": "ats-technical",
  "title": "ATS technical monitoring",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "ats",
    "technical"
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ats-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint,status) (rate(ats_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ats-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ats-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint,status) (rate(ats_http_errors_total[1m]))",
          "legendFormat": "{{endpoint}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ats-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Rank latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ats-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ats_http_request_duration_seconds_bucket{endpoint=\"/rank\"}[1m])))",
          "legendFormat": "p95 seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "ats-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Pipeline requests by durable status",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "ats-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ats_pipeline_requests",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ats-prometheus"
          },
